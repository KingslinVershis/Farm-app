# Database Routing Configuration
# In dev mode, the application uses local Postgres:
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/Farm_DB

# On deployed site (Vercel), the application uses Neon Postgres:
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Standard Fallback Database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/Farm_DB

# Optional: Force database target regardless of environment ('neon' | 'local')
# FORCE_DB_TARGET=local

# Authentication & Security
JWT_SECRET=my-secret-key

# ReactBits UI License
REACTBITS_LICENSE_KEY=

# Mailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="FarmHub Support <your_email@gmail.com>"

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
